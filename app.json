{
  "expo": {
    "name": "Crib",
    "slug": "crib",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "crib",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.crib.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1ccf9ad5-b297-4e1b-9a78-07c1e9e38cbb"
      }
    }
  }
}
